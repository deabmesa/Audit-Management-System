# JVM options (optional)
JAVA_OPTS=-Xms512m -Xmx2048m

# Oracle write datasource
ORACLE_JDBC_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_USERNAME=audit_app
ORACLE_PASSWORD=audit_app

# Oracle read-only datasource
ORACLE_READONLY_JDBC_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_READONLY_USERNAME=audit_report_reader
ORACLE_READONLY_PASSWORD=audit_report_reader

# PostgreSQL datasource
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/audit_reporting
POSTGRES_USERNAME=audit_reporting
POSTGRES_PASSWORD=audit_reporting

# JWT
JWT_SECRET=replace-with-strong-256-bit-secret
JWT_EXPIRATION_MS=3600000

# Logging path
APP_LOG_FILE=/var/log/audit-management/audit-management.log
