[Unit]
Description=Audit Management System (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=auditapp
Group=auditapp
WorkingDirectory=/opt/audit-management
EnvironmentFile=/etc/audit-management/audit-management.env
ExecStart=/bin/bash -lc "/usr/bin/java ${JAVA_OPTS:-} -jar /opt/audit-management/audit-management-system.jar --spring.profiles.active=rhel8"
SuccessExitStatus=143
Restart=always
RestartSec=10
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/audit-management

[Install]
WantedBy=multi-user.target
