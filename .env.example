APP_NAME="Audit Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=audit_management
DB_USERNAME=postgres
DB_PASSWORD=

DB_ORACLE_TNS=
DB_ORACLE_HOST=127.0.0.1
DB_ORACLE_PORT=1521
DB_ORACLE_DATABASE=XE
DB_ORACLE_SERVICE_NAME=XE
DB_ORACLE_USERNAME=readonly_user
DB_ORACLE_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
